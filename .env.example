# --- Niko Home Control II (Hobby API) ---------------------------------------
# IP-adres van de Connected Controller op je thuisnetwerk
NIKO_HOST=192.168.1.50
NIKO_PORT=8884
NIKO_USERNAME=hobby
# JWT-token uit mynikohomecontrol.niko.eu (Hobby API activeren, 1 jaar geldig)
NIKO_TOKEN=plak-hier-je-hobby-api-token
# Welke sensor? Geef de naam zoals in de Niko-programmeersoftware OF de UUID.
# Tip: `npm run devices` toont alle toestellen met een temperatuur.
NIKO_SENSOR_NAME=Woonkamer
NIKO_SENSOR_UUID=

# --- Seitron Hygge Way via IFTTT --------------------------------------------
# Sleutel van de IFTTT Webhooks-service (https://ifttt.com/maker_webhooks/settings)
IFTTT_KEY=plak-hier-je-ifttt-webhooks-key
# Event voor applet "Webhooks -> Seitron Smart: Set temperature" (setpoint in value1)
IFTTT_EVENT_SET_TEMPERATURE=hygge_set_temperature
# Event voor applet "Webhooks -> Seitron Smart: Switch to scheduled mode"
IFTTT_EVENT_AUTO=hygge_auto

# --- Regeling (alles in °C en minuten) ----------------------------------------
# Gewenste kamertemperatuur gemeten door de Niko-sensor
TARGET_TEMP=21
# Schakelmarge: verwarmen onder 20,7 °C, stoppen boven 21,3 °C
HYSTERESIS=0.3
# Setpoint dat naar de Hygge gaat om de ketel AAN te zetten
HEAT_SETPOINT=25
# Setpoint dat naar de Hygge gaat om de ketel UIT te zetten
IDLE_SETPOINT=12
# Minimale tijd tussen twee commando's (beschermt ketel en IFTTT-limieten)
MIN_SWITCH_INTERVAL_MIN=10
# Geen meting van de Niko-sensor gedurende deze tijd -> Hygge terug naar eigen schema
STALE_AFTER_MIN=30
# Zelfde commando om de X minuten herhalen (voor het geval IFTTT iets mist); 0 = nooit
RESEND_AFTER_MIN=60

# true = niets naar IFTTT sturen, enkel loggen
DRY_RUN=false

# Locatie voor zonsopgang/-ondergang (zonne-info wordt 's nachts verborgen). Standaard: Brussel.
LATITUDE=50.85
LONGITUDE=4.35

# Hoes zoeken bij radionummers (stuurt artiest en titel naar iTunes/Deezer). Zet op false om uit te zetten.
# BLUOS_COVERS=true
